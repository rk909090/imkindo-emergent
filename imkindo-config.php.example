<?php
/**
 * Imkindo — private SMTP config for enquiry.php
 *
 * Deployed alongside enquiry.php inside `public_html/`.
 * Protected by TWO layers:
 *   1. The `IMK_INTERNAL` guard below — direct HTTP requests are terminated
 *      with a 403 before credentials are ever accessed.
 *   2. `.htaccess` (shipped next to enquiry.php) issues a hard `403 Forbidden`
 *      before PHP even runs.
 *
 * Never commit this file with real credentials — .gitignore keeps it out
 * of the repo. The `.example` template lives at /app/imkindo-config.php.example.
 */

if (!defined('IMK_INTERNAL')) {
    http_response_code(403);
    exit('Forbidden');
}

return [
    'smtp_host'     => 'smtp.hostinger.com',
    'smtp_port'     => 465,
    'smtp_user'     => 'mark@imkindo.com',
    'smtp_password' => '#1000LeadsEveryday@2026',
    'from_name'     => 'Imkindo',
    'notify_to'     => 'mark@imkindo.com',
];
